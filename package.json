{
  "name": "gyansetu",
  "version": "1.0.0",
  "description": "GyaanSetu is an AI-powered learning and placement preparation platform designed to help college students and fresh graduates improve their programming skills, practise coding questions, identify recurring mistakes, and prepare for technical interviews.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "bugs": {
    "url": "https://github.com/bishtayushman990-cmyk/Gyansetu/issues"
  },
  "homepage": "https://github.com/bishtayushman990-cmyk/Gyansetu#readme",
  "dependencies": {
    "@google/genai": "^2.28.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
